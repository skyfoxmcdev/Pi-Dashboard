[Unit]
Description=Pi Dashboard — mise à jour depuis GitHub Releases
Documentation=file:/opt/pi-dashboard/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pi-dashboard/update.json

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/pi-dashboard
ExecStart=/usr/bin/python3 -m backend.updater run --auto
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300
UMask=0022

# L'updater doit pouvoir remplacer le code et redémarrer les services.
# Le reste du système reste en lecture seule.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/pi-dashboard /var/lib/pi-dashboard /etc/pi-dashboard /etc/systemd/system
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
