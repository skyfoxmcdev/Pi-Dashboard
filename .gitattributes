# Les scripts seront exécutés sur Linux : forcer des fins de ligne LF.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Ces fichiers ne servent pas à l'exécution sur le Raspberry Pi.
.github export-ignore
.gitignore export-ignore
config/config.json export-ignore
dist export-ignore
.tmp export-ignore
